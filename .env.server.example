# EC2 only, copy to .env
API_KEY=replace-with-the-same-shared-secret-used-by-the-emitter
SLACK_ADMIN_USER_TOKEN=xoxp-replace-with-the-dedicated-canary-admin-user-token
SLACK_CHANNEL_ID=C_REPLACE_WITH_CHANNEL_ID

CANARY_STATUS_URL=http://heartbeat:8000/status
CANARY_HOST_SERVICE=fsaelinux
CANARY_EXPECTED_SERVICES=fsaelinux,MFHome,InfluxDB,Wiki,ThePipeline,Grafana
CANARY_POLL_INTERVAL=10
CANARY_CONFIRMATION_SECONDS=60
CANARY_REMINDER_SECONDS=3600
CANARY_DISK_THRESHOLD=90
CANARY_DISK_CLEAR=85